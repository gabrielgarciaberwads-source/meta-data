                                                          "language":  "javaScript",
                                                          "jsCode":  "const runId = $(\u0027Start Collection Run\u0027).first().json.id;\nconst mediaItems = $(\u0027Normalize Collaborative Media\u0027).all();\nconst lit = (value) =\u003e value === null || value === undefined ? \u0027NULL\u0027 : \"\u0027\" + String(value).replaceAll(\"\u0027\", \"\u0027\u0027\") + \"\u0027\";\nconst json = (value) =\u003e lit(JSON.stringify(value ?? {})) + \u0027::jsonb\u0027;\nconst out=[];\nfor (let i=0;i\u003citems.length;i++) {\n  const media = mediaItems[i]?.json ?? {};\n  const response = items[i].json?.body ?? items[i].json ?? {};\n  const collaborators = Array.isArray(response.data) ? response.data : [];\n  let sql = \"INSERT INTO meta_raw.instagram_media (account_id, instagram_media_id, media_type, media_product_type, caption, permalink, published_at, username, owner_instagram_id, is_collab, last_seen_at, raw_payload, collection_run_id) VALUES (\" + lit(\u002717841449595671459\u0027) + \",\" + lit(media.media_id) + \",\" + lit(media.media_payload?.media_type ?? null) + \",\" + lit(media.media_payload?.media_product_type ?? null) + \",\" + lit(media.media_payload?.caption ?? null) + \",\" + lit(media.media_payload?.permalink ?? null) + \",\" + lit(media.media_payload?.timestamp ?? null) + \",\" + lit(media.media_payload?.username ?? null) + \",\" + lit(media.media_payload?.owner?.id ?? null) + \",true,now(),\" + json(media.media_payload) + \",\" + lit(runId) + \") ON CONFLICT (account_id, instagram_media_id) DO UPDATE SET media_type=EXCLUDED.media_type, media_product_type=EXCLUDED.media_product_type, caption=EXCLUDED.caption, permalink=EXCLUDED.permalink, published_at=EXCLUDED.published_at, username=EXCLUDED.username, owner_instagram_id=EXCLUDED.owner_instagram_id, is_collab=true, last_seen_at=now(), raw_payload=EXCLUDED.raw_payload, collection_run_id=EXCLUDED.collection_run_id;\";\n  for (const collaborator of collaborators) sql += \"INSERT INTO meta_raw.instagram_media_collaborators (account_id, instagram_media_id, instagram_user_id, username, role, invite_status, last_seen_at, raw_payload, collection_run_id) VALUES (\" + lit(\u002717841449595671459\u0027) + \",\" + lit(media.media_id) + \",\" + lit(collaborator.id) + \",\" + lit(collaborator.username ?? null) + \",\" + lit(collaborator.role ?? null) + \",\" + lit(collaborator.invite_status ?? null) + \",now(),\" + json(collaborator) + \",\" + lit(runId) + \") ON CONFLICT (account_id, instagram_media_id, instagram_user_id) DO UPDATE SET username=EXCLUDED.username, role=EXCLUDED.role, invite_status=EXCLUDED.invite_status, last_seen_at=now(), raw_payload=EXCLUDED.raw_payload, collection_run_id=EXCLUDED.collection_run_id;\";\n  if (!collaborators.length) sql += \"INSERT INTO meta_raw.integration_logs (collection_run_id, workflow_name, endpoint, status, error_code, error_message, finished_at) VALUES (\" + lit(runId) + \",\u0027OWNERINC - META RAW - Collaborative Media - C2\u0027,\u0027/collaborators\u0027,\u0027WARNING\u0027,\u0027UNSUPPORTED_OR_EMPTY\u0027,\u0027No collaborators returned for media\u0027,now());\";\n  out.push({json:{sql}});\n}\nif(!out.length) out.push({json:{sql:\u0027SELECT 0 AS collaborative_media_written;\u0027}});\nreturn out;"
