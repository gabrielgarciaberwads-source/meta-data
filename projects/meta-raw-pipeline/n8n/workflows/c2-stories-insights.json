                                                          "jsCode":  "const runId = $(\u0027Start Collection Run\u0027).first().json.id;\nconst consultableStories = $(\u0027Load Consultable Stories\u0027).all().map((item) =\u003e item.json ?? {});\nconst lit = (value) =\u003e value === null || value === undefined ? \u0027NULL\u0027 : \"\u0027\" + String(value).replaceAll(\"\u0027\", \"\u0027\u0027\") + \"\u0027\";\nconst json = (value) =\u003e lit(JSON.stringify(value ?? {})) + \u0027::jsonb\u0027;\nconst toFiniteNumber = (value) =\u003e {\n  if (value === null || value === undefined || value === \u0027\u0027) return null;\n  const number = Number(value);\n  return Number.isFinite(number) ? number : null;\n};\nconst metricNames = [\u0027reach\u0027,\u0027replies\u0027,\u0027navigation\u0027];\nconst out = [];\nfor (const [index, item] of items.entries()) {\n  const story = item.json ?? {};\n  const sourceStory = consultableStories[index] ?? {};\n  const storyId = story.story_id ?? sourceStory.story_id;\n  if (!storyId) continue;\n  const response = story.body ?? story;\n  const payload = response.body ?? response;\n  const errorText = JSON.stringify(payload?.error ?? payload?.errors ?? \u0027\u0027);\n  const unavailable = /insufficient|viewer|privacy/i.test(errorText) ? \u0027INSUFFICIENT_VIEWERS\u0027 : \u0027UNAVAILABLE\u0027;\n  const found = Array.isArray(payload?.data) ? payload.data : [];\n  const byName = new Map(found.map((metric) =\u003e [metric.name, metric]));\n  for (const name of metricNames) {\n    const metric = byName.get(name);\n    const status = metric ? \u0027AVAILABLE\u0027 : unavailable;\n    const value = toFiniteNumber(metric?.values?.[0]?.value ?? metric?.value);\n    out.push({ json: { sql: \"INSERT INTO meta_raw.instagram_story_metrics (account_id, story_id, metric_name, metric_value_numeric, metric_status, observed_at, raw_payload, collection_run_id) VALUES (\" + lit(\u002717841449595671459\u0027) + \",\" + lit(storyId) + \",\" + lit(name) + \",\" + (value === null ? \u0027NULL\u0027 : String(value)) + \",\" + lit(status) + \",now(),\" + json(payload) + \",\" + lit(runId) + \") ON CONFLICT (account_id, story_id, metric_name, observed_at) DO UPDATE SET metric_value_numeric=EXCLUDED.metric_value_numeric, metric_status=EXCLUDED.metric_status, raw_payload=EXCLUDED.raw_payload, collection_run_id=EXCLUDED.collection_run_id RETURNING story_id, metric_name, metric_status;\" } });\n  }\n}\nif (!out.length) out.push({ json: { sql: \u0027SELECT 0 AS story_metrics_written;\u0027 } });\nreturn out;"
